# Op8n Environment Configuration

# Optional default server-side Gemini API key (if BYOK is not provided by client)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: set to true to allow connecting to local/private n8n instances (SSRF safety flag)
ALLOW_LOCAL_N8N=false
