# Op8n Server-Only Environment Configuration (Vercel Serverless)
# These variables are read STRICTLY on the server and NEVER exposed to the client bundle, DevTools, or network tab.

# Primary Server AI Key (Server-Only):
# Recommended: Google Gemini key from https://aistudio.google.com/app/apikey
AI_API_KEY=

# Existing server-side Gemini key fallback
GEMINI_API_KEY=

# Optional: Default AI Provider ('gemini' | 'openai' | 'anthropic', defaults to 'gemini')
AI_PROVIDER=gemini

# Optional: Default Model (defaults to 'gemini-2.5-flash')
AI_MODEL=gemini-2.5-flash

# Optional: Set to true to allow connecting to local/private n8n instances (SSRF safety flag)
ALLOW_LOCAL_N8N=false
